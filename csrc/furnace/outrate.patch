+// modland-player: the rate a file is written at (the player's is 48000)
+TAParamResult pOutRate(String val) {
+  try {
+    int rate=std::stoi(val);
+    if (rate<8000 || rate>192000) {
+      logE("output rate shall be between 8000 and 192000.");
+      return TA_PARAM_ERROR;
+    }
+    exportOptions.sampleRate=rate;
+  } catch (std::exception& e) {
+    logE("output rate shall be a number.");
+    return TA_PARAM_ERROR;
+  }
+  return TA_PARAM_SUCCESS;
+}
