#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""bbmp-furnace <file> <track> <samplerate> [start-ms]

Plays Deflemask/FamiTracker/Furnace songs with a headless Furnace in modland's pipe
protocol: one JSON line, then s16le stereo. Furnace's audio pipe loops forever, so
the song is rendered once (through its first loop) to a temporary WAV, and streamed
from there as it is written (a long song takes Furnace many seconds).
"""

import json
import os
import zlib
import subprocess
import sys
import tempfile
import time
import wave
from pathlib import Path

HERE = Path(__file__).resolve().parent
FURNACE = HERE / "furnace"
ENV = {**os.environ, "XDG_CONFIG_HOME": str(HERE.parent / "config")}


def info(path: str) -> dict:
    out = subprocess.run([FURNACE, "-info", path], capture_output=True, text=True,
                         errors="replace", env=ENV, timeout=60).stdout
    meta = {}
    for line in out.splitlines():
        for key in ("name", "author", "system"):
            if line.startswith(f"- {key}: "):
                meta.setdefault(key, line.split(": ", 1)[1].strip())
    meta["subsongs"] = sum(1 for line in out.splitlines() if line.startswith("=== "))
    return meta


# Furnace also imports audio samples and turns them into a "song"; only accept music.
SONG_EXTS = {".fur", ".dmf", ".ftm", ".0cc", ".dnm", ".eft", ".tfe", ".fte"}


def unpacked(path: str, tmp: str) -> tuple[str, str]:
    """A Deflemask file is zlib-packed. Some of Modland's were sent as text once, which
    turned every CR LF in them into LF and broke the pack's checksum; Furnace then
    refuses them. Unpacked without the checksum, some of them still play. Gives the
    file to give Furnace, and a note when it is damaged."""
    if not path.lower().endswith(".dmf"):
        return path, ""
    data = Path(path).read_bytes()
    try:
        zlib.decompress(data)
        return path, ""
    except zlib.error:
        pass
    try:
        raw = zlib.decompressobj(-15).decompress(data[2:])
    except zlib.error:
        return path, ""
    if not raw.startswith(b".DelekDefleMask."):
        return path, ""
    out = Path(tmp) / "unpacked.dmf"
    out.write_bytes(raw)
    return str(out), ("the file on Modland is damaged: it was once sent as text, which "
                      "turned every CR LF in it into LF")


def main() -> int:
    path, track = sys.argv[1], int(sys.argv[2])
    if Path(path).suffix.lower() not in SONG_EXTS:
        print(json.dumps({"tracks": 0, "error": "not a Furnace/Deflemask/FamiTracker song"}), flush=True)
        return 1
    start_ms = int(sys.argv[4]) if len(sys.argv) > 4 else 0
    rate = int(sys.argv[3]) if len(sys.argv) > 3 else 48000     # Furnace's own is 44100
    tmp = tempfile.mkdtemp(prefix="bbmp-furnace-")
    path, damaged = unpacked(path, tmp)
    meta = info(path)
    wav = Path(tmp) / "song.wav"
    furnace = subprocess.Popen(
        [FURNACE, "-console", "-nostatus", "-nocontrols", "-loglevel", "error", "-loops", "0",
         "-subsong", str(track), "-outformat", "s16", "-outrate", str(rate), "-output", str(wav),
         path],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=ENV)
    try:
        return stream(furnace, wav, meta, track, start_ms, damaged)
    finally:
        if furnace.poll() is None:
            furnace.kill()
        leave_nothing(Path(tmp))


def leave_nothing(tmp: Path) -> None:
    for name in ("song.wav", "unpacked.dmf"):
        (tmp / name).unlink(missing_ok=True)
    try:
        os.rmdir(tmp)
    except OSError:
        pass


def _data_start(head: bytes) -> tuple[int, int] | None:
    """(where the sound starts, sample rate) in the first bytes of a WAV file."""
    if len(head) < 12 or head[:4] != b"RIFF" or head[8:12] != b"WAVE":
        return None
    at, rate = 12, 0
    while at + 8 <= len(head):
        kind, size = head[at:at + 4], int.from_bytes(head[at + 4:at + 8], "little")
        if kind == b"fmt ":
            rate = int.from_bytes(head[at + 12:at + 16], "little")
        if kind == b"data":
            return at + 8, rate
        at += 8 + size + (size & 1)
    return None


WAIT = 4.0      # seconds to wait for all of a song: then its length is known


def stream(furnace, wav: Path, meta: dict, track: int, start_ms: int, damaged: str) -> int:
    """Send the sound as Furnace writes it. A long song takes Furnace longer to render
    than a player waits for its first sound, so it isn't waited for: a song that is done
    within WAIT seconds has its length, a longer one is sent as it comes and ends when
    Furnace is done."""
    began = time.monotonic()
    while furnace.poll() is None and time.monotonic() - began < WAIT:
        time.sleep(0.05)
    finished = furnace.poll() is not None
    while not wav.exists() and furnace.poll() is None:
        time.sleep(0.02)
    if not wav.exists():
        why = damaged or "Furnace couldn't render this song"
        print(json.dumps({"tracks": 0, "error": why}), flush=True)
        return 1
    audio = open(wav, "rb")
    # Furnace writes into the file it has open, and this reads from its own: the names
    # can go now. The player kills this helper when it moves on, and a killed process
    # cleans nothing up; /tmp is often in memory.
    leave_nothing(Path(wav).parent)
    found = None
    while found is None:
        head = audio.read(4096)
        audio.seek(0)
        found = _data_start(head)
        if found is None:
            if furnace.poll() is not None and len(head) < 4096:
                print(json.dumps({"tracks": 0, "error": "Furnace wrote no sound"}), flush=True)
                return 1
            time.sleep(0.02)
    start, rate = found
    rate = rate or 48000
    duration = 0
    if finished:
        duration = max(0, os.fstat(audio.fileno()).st_size - start) // 4 * 1000 // rate
    head = {"tracks": max(1, meta.get("subsongs", 1)), "track": track,
            "title": meta.get("name", ""), "author": meta.get("author", ""),
            "type": "Furnace " + meta.get("system", ""), "duration_ms": duration}
    sys.stdout.write(json.dumps(head) + "\n")
    sys.stdout.flush()
    skip = start_ms * rate // 1000 * 4
    audio.seek(start)
    out = sys.stdout.buffer
    rest = b""
    try:
        while True:
            chunk = audio.read(65536)
            if not chunk:
                if furnace.poll() is not None:
                    chunk = audio.read(65536)       # what came after the last look
                    if not chunk:
                        break
                else:
                    time.sleep(0.02)
                    continue
            if skip:
                cut = min(skip, len(chunk))
                chunk, skip = chunk[cut:], skip - cut
            chunk = rest + chunk
            whole = len(chunk) // 4 * 4                 # whole stereo frames only
            chunk, rest = chunk[:whole], chunk[whole:]
            out.write(chunk)
    except BrokenPipeError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
