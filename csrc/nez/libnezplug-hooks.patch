diff --git a/src/include/nezplug/nezplug.h b/src/include/nezplug/nezplug.h
--- a/src/include/nezplug/nezplug.h
+++ b/src/include/nezplug/nezplug.h
@@ -230,6 +230,19 @@ struct NEZ_PLAY_ {
 	void *nsdp;
 };
 
+/* modland: the caller is told of every write to a sound chip and of every
+ * interrupt that calls the song's play routine (both may be NULL) */
+extern void (*nez_hook_write)(uint32_t addr, uint32_t value);
+extern void (*nez_hook_frame)(void);
+/* modland: one byte per byte of the song's ROM, set when the program reads it;
+ * nez_hook_fresh counts the bytes read for the first time */
+extern uint8_t *nez_hook_seen;
+extern uint32_t nez_hook_seen_size;
+extern uint32_t nez_hook_fresh;
+/* modland: how often a ColecoVision song read the BIOS ROM (past the first bytes,
+ * where the player's own code is) */
+extern uint32_t nez_hook_bios;
+
 /* NEZ player */
 NEZ_PLAY* NEZNew();
 void NEZDelete(NEZ_PLAY*);
