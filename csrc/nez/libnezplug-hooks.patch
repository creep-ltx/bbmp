+/* modland: the offset of a ROM bank. A bank the file doesn't have wraps round, as
+ * the mapper's address lines do, instead of pointing past the data. */
+static uint32_t sgc_bank(SGCSEQ *THIS_, uint32_t n)
+{
+	return (n % THIS_->banknum) * 0x4000;
+}
