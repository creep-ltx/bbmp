+// modland: the decompressors above, for data that may be damaged.
+bool BEERZ77Decomp2(uint8_t const * pSource, std::size_t sourceSize, uint8_t ** pDestination, std::size_t * pDestinationSize) {
+	if(!pSource || sourceSize < 5 || pSource[0] != 0x04) return false;
+	uint32_t const FileSize = ReadLittleEndian32(pSource + 1);
+	// a token of 3 bytes gives at most 255 + MIN_REDUNDANT_BYTES_2 bytes
+	if(FileSize > 0x7fffffff || FileSize / (255 + MIN_REDUNDANT_BYTES_2) > sourceSize / 3 + 1) return false;
+	uint8_t const * pSourcePos = pSource + 5;
+	uint8_t const * const pSourceEnd = pSource + sourceSize;
+	uint8_t * const pDest = new uint8_t[FileSize ? FileSize : 1];
+	uint8_t * pDestPos = pDest;
+	std::size_t left = FileSize;
+	while(left > 0) {
+		if(pSourcePos >= pSourceEnd) { delete[] pDest; return false; }
+		std::size_t Length = *pSourcePos++;
+		if(Length) {
+			if(Length > left || Length > static_cast<std::size_t>(pSourceEnd - pSourcePos)) { delete[] pDest; return false; }
+			std::memcpy(pDestPos, pSourcePos, Length);
+			pSourcePos += Length;
+		} else {
+			if(pSourceEnd - pSourcePos < 2) { delete[] pDest; return false; }
+			Length = static_cast<std::size_t>(*pSourcePos++) + MIN_REDUNDANT_BYTES_2;
+			std::size_t const Offset = *pSourcePos++;
+			if(Length > left || Offset + Length > static_cast<std::size_t>(pDestPos - pDest)) { delete[] pDest; return false; }
+			std::memcpy(pDestPos, pDestPos - Offset - Length, Length);
+		}
+		pDestPos += Length;
+		left -= Length;
+	}
+	*pDestination = pDest;
+	*pDestinationSize = FileSize;
+	return true;
+}
+
+bool SoundDesquash(uint8_t const * pSource, std::size_t sourceSize, int16_t ** pDestination, std::size_t * pDestinationSize) {
+	if(!pSource || sourceSize < 5 || pSource[0] != 0x01) return false;
+	static const int16_t mask[16] = {
+		0x0000, 0x0001, 0x0003, 0x0007, 0x000f, 0x001f, 0x003f, 0x007f,
+		0x00ff, 0x01ff, 0x03ff, 0x07ff, 0x0fff, 0x1fff, 0x3fff, 0x7fff
+	};
+	uint32_t const FileSize = ReadLittleEndian32(pSource + 1);
+	std::size_t const bitsThere = (sourceSize - 5) * 8;
+	// a sample takes 5 bits at least
+	if(FileSize > bitsThere / 5) return false;
+	int16_t * const pDest = new int16_t[FileSize ? FileSize : 1];
+	std::size_t bit = 0;
+	int16_t prevprev = 0;
+	int16_t prev = 0;
+	for(uint32_t n = 0; n < FileSize; ++n) {
+		// the 32 bits from the byte of this sample on, as the original reads them; past the end they are 0
+		std::size_t const at = 5 + bit / 8;
+		uint32_t bits = 0;
+		for(int k = 3; k >= 0; --k) bits = (bits << 8) | (at + k < sourceSize ? pSource[at + k] : 0);
+		bits >>= bit % 8;
+		int const numbits = bits & 0x0f;
+		uint32_t const sign = bits & 0x010;
+		bits >>= 5;
+		if(bit + numbits + 5 > bitsThere) { delete[] pDest; return false; }
+		int16_t error = static_cast<int16_t>(bits & mask[numbits]);
+		if(sign) error |= static_cast<int16_t>((0xffff << numbits) & 0xffff);
+		int16_t const t = ((prev + (prev - prevprev)) + error) & 0xffff;
+		pDest[n] = t;
+		prevprev = prev;
+		prev = t;
+		bit += numbits + 5;
+	}
+	*pDestination = pDest;
+	*pDestinationSize = FileSize;
+	return true;
+}
