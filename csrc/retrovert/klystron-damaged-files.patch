bbmp: klystron (Klystrack's engine) read a damaged file's counts and sizes without a check
(the final audit of 7 October 2026): channels, effects, wavetables, instruments, program
steps and names past their arrays, a pattern that isn't there, a song rate of 0 (it divides),
a reverb delay longer than its buffer, the top note's neighbour; and a read past the file's
end left the old contents of the buffer. Each is checked; real songs play as before.
diff --git a/src/lib/ksnd.c b/src/lib/ksnd.c
index a94af4f..c4677d3 100644
--- a/src/lib/ksnd.c
+++ b/src/lib/ksnd.c
@@ -46,8 +46,17 @@ KLYSAPI KSong* KSND_LoadSong(KPlayer* player, const char *path)
 #ifndef USESDL_RWOPS
 static int RWread(struct RWops *context, void *ptr, int size, int maxnum)
 {
-	const int len = my_min(size * maxnum, context->mem.length - context->mem.ptr);
-	memcpy(ptr, context->mem.base + context->mem.ptr, len);
+	/* bbmp: the size in 64 bits (size * maxnum overflowed), and what a damaged file
+	   asks for past its end reads as zeros, not as what the buffer held before */
+	const long long want = (long long)size * maxnum;
+	if (want <= 0)
+		return 0;
+	const long long left = context->mem.length - context->mem.ptr;
+	const long long len = want < left ? want : (left > 0 ? left : 0);
+	if (len > 0)
+		memcpy(ptr, context->mem.base + context->mem.ptr, len);
+	if (want > len)
+		memset((char *)ptr + len, 0, want - len);
 
 	context->mem.ptr += len;
 
